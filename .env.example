# =============================================================================
# AmphixDocs - Variables d'environnement
# =============================================================================
#
# 1. En développement local dans VS Code :
#    Créez un fichier '.env.local' à la racine et collez vos clés :
#
# 2. En production sur Vercel :
#    Ajoutez ces deux variables dans : Project Settings > Environment Variables
# =============================================================================

# URL de votre projet Supabase (ex: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL="https://votre-projet.supabase.co"

# Clé anonyme publique de votre projet Supabase (anon public key)
VITE_SUPABASE_ANON_KEY="votre-cle-anon-publique-supabase"
